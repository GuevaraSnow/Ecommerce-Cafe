# Copia este archivo como ".env" (en esta misma carpeta) y completa lo que uses.
# El archivo ".env" NO se sube al repositorio. docker compose lo lee solo.
# Todo es opcional: sin estas claves la aplicacion funciona, menos el chat con IA y la subida de fotos.

# Asesor de ventas con IA (console.groq.com > API Keys)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Fotos de los productos (Cloudinary > Settings > API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Otros ajustes (valores por defecto)
# JWT_SECRET=cafe-trazado-clave-de-desarrollo-no-usar-en-produccion
# DATOS_DE_EJEMPLO=always     # never: la base empieza vacia
# APP_PORT=8080
# DB_PORT=3307
